# Local `go build` output. Named after the package directory, so `daemon`.
# The shipped binary is produced inside the Docker build stage and installed as
# /usr/bin/infinitive; it is never committed.
/bryant-carrier/daemon/daemon
/bryant-carrier/daemon/daemon.exe
*.test
*.out

.DS_Store

# Git Bash leaves these behind when a shell crashes on Windows.
*.stackdump
