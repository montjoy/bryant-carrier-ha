#!/command/with-contenv bashio
# shellcheck shell=bash
#
# Take the container down when the daemon exits, instead of letting s6 restart
# it forever.  A wrong serial path would otherwise produce a restart loop that
# buries the actual error partway up the add-on log.

# The results file exists only while s6-overlay is acting as container init.
# Reading it unconditionally wrote "No such file or directory" into the add-on
# log on every service exit, directly on top of the error being reported.
readonly container_results=/run/s6-linux-init-container-results/exit
if [[ -f "${container_results}" ]]; then
    readonly exit_code_container=$(<"${container_results}")
else
    readonly exit_code_container=0
fi

readonly exit_code_service="${1}"
readonly exit_code_signal="${2}"
readonly service="bryant-carrier"

bashio::log.info \
    "Service ${service} exited with code ${exit_code_service}" \
    "(by signal ${exit_code_signal})"

if [[ "${exit_code_service}" -eq 256 ]]; then
    # Killed by a signal.  Preserve the first failure the container saw.
    if [[ "${exit_code_container}" -eq 0 ]] && [[ -f "${container_results}" ]]; then
        echo $((128 + exit_code_signal)) > "${container_results}"
    fi
    # SIGTERM is a normal add-on stop; shut the container down cleanly.
    [[ "${exit_code_signal}" -eq 15 ]] && exec /run/s6/basedir/bin/halt
elif [[ "${exit_code_service}" -ne 0 ]]; then
    if [[ "${exit_code_container}" -eq 0 ]] && [[ -f "${container_results}" ]]; then
        echo "${exit_code_service}" > "${container_results}"
    fi
    exec /run/s6/basedir/bin/halt
fi
