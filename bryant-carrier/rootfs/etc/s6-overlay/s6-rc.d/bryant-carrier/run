#!/command/with-contenv bashio
# shellcheck shell=bash
#
# Start the Infinitive daemon.
#
# The previous version parsed /data/options.json with raw jq, then launched the
# binary without exec -- so the shell stayed as PID 1 of the service and SIGTERM
# never reached the daemon on stop.

set -e

SERIAL=$(bashio::config 'serial')
# Trim stray whitespace.  The by-id paths are long enough that they are always
# pasted rather than typed, and a leading or trailing space riding along turns
# every filesystem test below into a false negative on a device that is present.
SERIAL="${SERIAL#"${SERIAL%%[![:space:]]*}"}"
SERIAL="${SERIAL%"${SERIAL##*[![:space:]]}"}"
LOG_LEVEL=$(bashio::config 'log_level')
ZONE=$(bashio::config 'zone')
MIN_SETPOINT=$(bashio::config 'min_setpoint')
MAX_SETPOINT=$(bashio::config 'max_setpoint')
MIN_SPREAD=$(bashio::config 'min_setpoint_spread')
DEVICE_NAME=$(bashio::config 'device_name')
DISCOVERY_PREFIX=$(bashio::config 'discovery_prefix')
TOPIC_PREFIX=$(bashio::config 'topic_prefix')
NODE_ID=$(bashio::config 'node_id')

# Fail loudly and early rather than letting the daemon panic on an open() of a
# device that is not there.  A renumbered /dev/ttyUSB* is the single most common
# way this add-on stops working after a reboot.
#
# -c rather than bashio::fs.device_exists, which refused to start the add-on on
# a /dev/ttyUSB0 that ls reported in the same breath as crw-rw---- 188, 0.  The
# helper does not test for a character device, so it rejected every serial port
# this add-on exists to open.  -c follows symlinks, so a /dev/serial/by-id/...
# path passes on the strength of whatever node it names.
if [[ ! -c "${SERIAL}" ]]; then
    bashio::log.fatal "Serial device ${SERIAL} does not exist."

    # Escaped, so a stray character that survived the trim above is visible
    # rather than printing as an ordinary-looking path.
    bashio::log.fatal "Configured value: $(printf '%q' "${SERIAL}")"
    bashio::log.fatal "Which is: $(ls -ld "${SERIAL}" 2>&1)"

    # Listing what is actually present is the only way to tell a wrong path
    # apart from a device that never got mapped into the container at all --
    # there is no way to exec into an add-on from the SSH add-on to check by
    # hand.  An empty list means the Supervisor mapped nothing, which is a
    # different problem from a typo in the option.
    shopt -s nullglob
    visible=(/dev/ttyUSB* /dev/ttyACM* /dev/ttyAMA* /dev/serial/by-id/*)
    shopt -u nullglob

    if [[ ${#visible[@]} -eq 0 ]]; then
        bashio::log.fatal "No serial devices are mapped into this add-on."
        bashio::log.fatal "The adapter is unplugged, or the Supervisor has not"
        bashio::log.fatal "applied this add-on's uart/usb settings.  Reload the"
        bashio::log.fatal "add-on store and Rebuild the add-on, then check that"
        bashio::log.fatal "'ha hardware info' lists the adapter on the host."
    else
        # ls -ld rather than the bare path: every /dev/serial/by-id entry is a
        # symlink, so what it points at is the part that decides whether the
        # device is usable.  A name can appear in this list and still fail the
        # test above, which is what a symlink whose target was not mapped into
        # the container looks like.
        bashio::log.fatal "Serial devices visible to this add-on:"
        for dev in "${visible[@]}"; do
            bashio::log.fatal "  $(ls -ld "${dev}" 2>&1)"
        done
        bashio::log.fatal "Entries starting with 'c' are usable devices."
        bashio::log.fatal "An entry starting with 'l' whose target is not itself"
        bashio::log.fatal "listed above is a symlink the Supervisor mapped without"
        bashio::log.fatal "its target; use that target's /dev/ttyUSB* path instead."
    fi

    bashio::exit.nok
fi

MQTT_ARGS=()
if bashio::config.true 'mqtt_enabled'; then
    # Prefer explicitly configured broker settings; otherwise take whatever the
    # Home Assistant MQTT service hands us, which is the normal case when the
    # Mosquitto add-on is running.
    if bashio::config.has_value 'mqtt_host'; then
        MQTT_HOST=$(bashio::config 'mqtt_host')
        MQTT_PORT=$(bashio::config 'mqtt_port' '1883')
        MQTT_USERNAME=$(bashio::config 'mqtt_username' '')
        MQTT_PASSWORD=$(bashio::config 'mqtt_password' '')
    elif bashio::services.available 'mqtt'; then
        MQTT_HOST=$(bashio::services 'mqtt' 'host')
        MQTT_PORT=$(bashio::services 'mqtt' 'port')
        MQTT_USERNAME=$(bashio::services 'mqtt' 'username')
        MQTT_PASSWORD=$(bashio::services 'mqtt' 'password')
    else
        bashio::log.warning "MQTT is enabled but no broker is configured and the"
        bashio::log.warning "Home Assistant MQTT service is unavailable."
        bashio::log.warning "Install the Mosquitto add-on or set mqtt_host."
    fi

    if bashio::var.has_value "${MQTT_HOST:-}"; then
        bashio::log.info "Publishing Home Assistant discovery to ${MQTT_HOST}:${MQTT_PORT}"
        MQTT_ARGS+=(
            "-mqtt-broker=${MQTT_HOST}:${MQTT_PORT}"
            "-mqtt-username=${MQTT_USERNAME}"
            "-mqtt-password=${MQTT_PASSWORD}"
            "-mqtt-discovery-prefix=${DISCOVERY_PREFIX}"
            "-mqtt-topic-prefix=${TOPIC_PREFIX}"
            "-mqtt-node-id=${NODE_ID}"
            "-mqtt-device-name=${DEVICE_NAME}"
        )
    fi
else
    bashio::log.info "MQTT disabled; the web UI and JSON API remain available."
fi

bashio::log.info "Starting Infinitive on ${SERIAL}"

# exec so the daemon becomes the service process and receives SIGTERM directly,
# letting it mark its MQTT entities offline and drain HTTP before exiting.
exec /usr/bin/infinitive \
    -serial="${SERIAL}" \
    -httpport=8080 \
    -loglevel="${LOG_LEVEL}" \
    -zone="${ZONE}" \
    -min-setpoint="${MIN_SETPOINT}" \
    -max-setpoint="${MAX_SETPOINT}" \
    -min-setpoint-spread="${MIN_SPREAD}" \
    "${MQTT_ARGS[@]}"
